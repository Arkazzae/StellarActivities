{
  "name": "kings-reigns",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:browser": "node scripts/browser-check.mjs",
    "check": "pnpm test && pnpm build && pnpm sdk:validate",
    "sdk:validate": "stellarr validate --dir dist",
    "sdk:dev": "stellarr dev --dir dist",
    "sdk:pack": "stellarr pack --dir dist --out .stellarr-release"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@stellarr/sdk": "0.4.0",
    "@types/node": "20.19.43",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
