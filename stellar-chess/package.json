{
  "name": "stellar-chess",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "pnpm test && pnpm build && pnpm sdk:validate",
    "sdk:validate": "node scripts/stellarr.mjs validate --dir dist",
    "sdk:dev": "node scripts/stellarr.mjs dev --dir dist",
    "sdk:pack": "node scripts/stellarr.mjs pack --dir dist --out .stellarr-release",
    "test:browser": "node scripts/browser-check.mjs",
    "art:placeholder": "node scripts/placeholder-art.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "chess.js": "^1.0.0-beta.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@stellarr/sdk": "0.3.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^6.0.1",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.14.0"
}
