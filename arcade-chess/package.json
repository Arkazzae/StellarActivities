{
  "name": "arcade-chess",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "pnpm test && pnpm build && pnpm sdk:validate",
    "sdk:validate": "node ../scripts/stellarr.mjs validate --dir dist",
    "sdk:dev": "node ../scripts/stellarr.mjs dev --dir dist",
    "sdk:pack": "node ../scripts/stellarr.mjs pack --dir dist --out .stellarr-release",
    "test:browser": "node scripts/browser-check.mjs",
    "art:placeholder": "node scripts/placeholder-art.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "chess.js": "1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@stellarr/sdk": "0.4.0",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
